digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.4, ranksep=0.36, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#9E9E9E"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];

  start [shape=circle, style=filled, fillcolor="#0B2545", fontcolor="white", color="#0B2545", label="Inicio", width=0.8, fixedsize=true];
  s1 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/08-vehicle-detail-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Vehicle detail</B></TD></TR></TABLE>>];
  d1 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿Su rol permite<BR/>levantar bloqueos?>];
  x1 [shape=box, style="rounded,filled", fillcolor="#E0E0E0", color="#4A4A4A", label=<<B>Fin alternativo</B><BR/>La acción «Lift block» no<BR/>está disponible: solo un<BR/>supervisor o un<BR/>administrador puede<BR/>autorizar>];
  a1 [shape=box, style="rounded,filled", fillcolor="#F7F8FA", color="#9E9E9E", label=<Presiona «Lift block» en<BR/>el vehículo «Not Enabled»>];
  s2 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/10-lift-block-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Lift block</B></TD></TR></TABLE>>];
  a2 [shape=box, style="rounded,filled", fillcolor="#F7F8FA", color="#9E9E9E", label=<Lee el motivo del bloqueo y<BR/>escribe el motivo de la<BR/>autorización en «Reason»>];
  d2 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿Escribió el motivo,<BR/>que es obligatorio?>];
  u1 [shape=box, style="rounded,filled", fillcolor="#FDECE8", color="#B8432B", penwidth=1.5, label=<<B>Unhappy path</B><BR/>El diálogo marca «Reason ·<BR/>required» y no autoriza la<BR/>salida hasta que se escriba>];
  d3 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿Presiona<BR/>«Authorize<BR/>departure»?>];
  x2 [shape=box, style="rounded,filled", fillcolor="#E0E0E0", color="#4A4A4A", label=<<B>Fin alternativo</B><BR/>Presiona «Cancel»: el<BR/>diálogo se cierra, el<BR/>vehículo sigue «Not Enabled»<BR/>y no se registra ninguna<BR/>excepción>];
  y2 [shape=box, style="rounded,filled", fillcolor="#D6E4F0", color="#1D4E89", label=<<B>El sistema</B><BR/>registra la excepción con el<BR/>motivo y el responsable, y<BR/>el vehículo pasa a «Enabled»>];
  s3 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/11-inspection-history-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Inspection history</B></TD></TR></TABLE>>];
  e1 [shape=box, style="rounded,filled,bold", fillcolor="#E3F4F1", color="#1F7A6E", penwidth=2, label=<<B>Fin</B><BR/>La excepción aparece con<BR/>«Yes» en «Exception» y el<BR/>nombre en «Authorized by»>];
  start -> s1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s1 -> d1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  d1 -> a1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>Sí</B>>];
  d1 -> x1 [color="#B8432B", fontcolor="#B8432B", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  a1 -> s2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s2 -> a2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  a2 -> d2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  d2 -> d3 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>Sí</B>>];
  d2 -> u1 [color="#B8432B", fontcolor="#B8432B", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  u1 -> s2 [color="#B8432B", fontcolor="#B8432B", style=dashed, penwidth=1.6, label=<<B>Corrige</B>>, constraint=false];
  d3 -> y2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>Sí</B>>];
  d3 -> x2 [color="#B8432B", fontcolor="#B8432B", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  y2 -> s3 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s3 -> e1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  { rank=same; d1; x1; }
  { rank=same; d2; u1; }
  { rank=same; d3; x2; }
}
