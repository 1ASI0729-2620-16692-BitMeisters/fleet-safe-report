digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.4, ranksep=0.36, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#9E9E9E"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];

  start [shape=circle, style=filled, fillcolor="#0B2545", fontcolor="white", color="#0B2545", label="Inicio", width=0.8, fixedsize=true];
  s1 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/07-fleet-dashboard-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Fleet</B></TD></TR></TABLE>>];
  a1 [shape=box, style="rounded,filled", fillcolor="#F7F8FA", color="#9E9E9E", label=<Revisa los contadores por<BR/>condición operativa>];
  d1 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿Hay vehículos<BR/>«Not Enabled»?>];
  a2 [shape=box, style="rounded,filled", fillcolor="#F7F8FA", color="#9E9E9E", label=<Presiona «View detail» en<BR/>el vehículo bloqueado>];
  s2 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/08-vehicle-detail-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Vehicle detail</B></TD></TR></TABLE>>];
  e1 [shape=box, style="rounded,filled,bold", fillcolor="#E3F4F1", color="#1F7A6E", penwidth=2, label=<<B>Fin</B><BR/>Identifica la unidad, su<BR/>conductor y sus documentos,<BR/>y la excluye del despacho>];
  d2 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿Hay vehículos<BR/>«Not inspected»?>];
  x1 [shape=box, style="rounded,filled", fillcolor="#E0E0E0", color="#4A4A4A", label=<<B>Fin alternativo</B><BR/>No puede confirmar esas<BR/>unidades; solicita al<BR/>supervisor que verifique su<BR/>inspección>];
  e2 [shape=box, style="rounded,filled,bold", fillcolor="#E3F4F1", color="#1F7A6E", penwidth=2, label=<<B>Fin</B><BR/>Confirma el despacho de la<BR/>flota>];
  start -> s1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s1 -> a1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  a1 -> d1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  d1 -> a2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>Sí</B>>];
  a2 -> s2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s2 -> e1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  d1 -> d2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>No</B>>];
  d2 -> x1 [color="#B8432B", fontcolor="#B8432B", style=dashed, penwidth=1.6, label=<<B>Sí</B>>];
  d2 -> e2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>No</B>>];
  { rank=same; d2; x1; }
}
