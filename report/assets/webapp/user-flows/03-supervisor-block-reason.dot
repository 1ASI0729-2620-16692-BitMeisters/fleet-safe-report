digraph G {
  graph [rankdir=TB, bgcolor="white", fontname="Inter", nodesep=0.4, ranksep=0.36, pad=0.3, newrank=true];
  node [fontname="Inter", fontsize=12, color="#9E9E9E"];
  edge [fontname="Inter", fontsize=11, arrowsize=0.8];

  start [shape=circle, style=filled, fillcolor="#0B2545", fontcolor="white", color="#0B2545", label="Inicio", width=0.8, fixedsize=true];
  s1 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/08-vehicle-detail-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Vehicle detail</B></TD></TR></TABLE>>];
  d1 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿El vehículo tiene<BR/>inspecciones<BR/>registradas?>];
  x1 [shape=box, style="rounded,filled", fillcolor="#E0E0E0", color="#4A4A4A", label=<<B>Fin alternativo</B><BR/>La pestaña «Inspections»<BR/>está vacía: el vehículo aún<BR/>no ha sido evaluado>];
  a1 [shape=box, style="rounded,filled", fillcolor="#F7F8FA", color="#9E9E9E", label=<Abre la inspección más<BR/>reciente con «View»>];
  s2 [shape=plain, label=<<TABLE BORDER="2" COLOR="#13315C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD FIXEDSIZE="TRUE" WIDTH="256" HEIGHT="144"><IMG SRC="../mockups/09-inspection-detail-desktop.png" SCALE="TRUE"/></TD></TR><TR><TD BGCOLOR="#D6E4F0"><B>Inspection detail</B></TD></TR></TABLE>>];
  y1 [shape=box, style="rounded,filled", fillcolor="#D6E4F0", color="#1D4E89", label=<<B>El sistema</B><BR/>muestra la regla aplicada y<BR/>los hallazgos con su<BR/>evidencia en «Why it is not<BR/>enabled»>];
  d2 [shape=diamond, style=filled, fillcolor="#FFF4D6", color="#B7791F", penwidth=1.5, margin="0.02,0.02", label=<¿La operación puede<BR/>esperar la<BR/>corrección?>];
  e1 [shape=box, style="rounded,filled,bold", fillcolor="#E3F4F1", color="#1F7A6E", penwidth=2, label=<<B>Fin</B><BR/>Mantiene el bloqueo y<BR/>gestiona la incidencia y la<BR/>reparación>];
  e2 [shape=box, style="rounded,filled,bold", fillcolor="#E3F4F1", color="#1F7A6E", penwidth=2, label=<<B>Fin</B><BR/>Evalúa autorizar la salida<BR/>con una excepción>];
  start -> s1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s1 -> d1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  d1 -> a1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>Sí</B>>];
  d1 -> x1 [color="#B8432B", fontcolor="#B8432B", style=dashed, penwidth=1.6, label=<<B>No</B>>];
  a1 -> s2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  s2 -> y1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  y1 -> d2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2];
  d2 -> e1 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>Sí</B>>];
  d2 -> e2 [color="#1F7A6E", fontcolor="#1F7A6E", penwidth=2.2, label=<<B>No</B>>];
  { rank=same; d1; x1; }
}
