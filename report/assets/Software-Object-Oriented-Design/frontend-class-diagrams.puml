@startuml
' FleetSafe - Single-Page Application (TypeScript / Angular)
' Naming conventions applied (TypeScript):
'   - Classes, interfaces and assemblers: PascalCase
'   - Attributes and methods: camelCase
'   - Enumerations: TypeScript enums, with their values in UPPER_SNAKE_CASE as in the code
'   - Private attributes of the domain classes: prefixed with # in the code (e.g. #id), shown here with -
'   - / before a name = getter (derived, read-only property)
'   - <<Action Endpoint>> = non-CRUD endpoint that extends ErrorHandlingEnabledBaseType; <<Endpoint>> = CRUD endpoint that extends BaseApiEndpoint
'   - <<Api>> = API facade of the context; it extends BaseApi, an abstract class with no members, so it is not drawn
'   - Signal<T> = Angular signal (read-only); each one has a private writable signal that is not drawn
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 40
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #ffffff
  BorderColor #1d4ed8
  ArrowColor #1e3a8a
}
skinparam package {
  BackgroundColor #eff6ff
  BorderColor #3b82f6
}
left to right direction

' Full diagram. Members are hidden so that the whole image fits in 4096 px (the default size limit of PlantUML) and is not cropped.
' Delete the next line to show attributes and methods (then render with -DPLANTUML_LIMIT_SIZE=16384); the diagrams per bounded context always show them.
hide members
scale max 4096x4096

package "Shared" {
  interface BaseEntity {
    + id: string
  }
  interface BaseResource {
    + id: string
  }
  interface BaseResponse
  interface "BaseAssembler<TEntity, TResource, TResponse>" as BaseAssembler {
    + toEntityFromResource(resource: TResource): TEntity
    + toResourceFromEntity(entity: TEntity): TResource
    + toEntitiesFromResponse(response: TResponse): TEntity[]
  }
  abstract class "BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler>" as BaseApiEndpoint {
    # http: HttpClient
    # endpointUrl: string
    # assembler: TAssembler
    + getAll(): Observable<TEntity[]>
    + getById(id: string): Observable<TEntity>
    + create(entity: TEntity): Observable<TEntity>
    + update(entity: TEntity, id: string): Observable<TEntity>
    + delete(id: string): Observable<void>
    # handleError(operation: string): function
  }
  abstract class Notifier {
    + {abstract} notify(severity: NotificationSeverity, messageKey: string, params: NotificationParams): void
    + success(messageKey: string, params: NotificationParams): void
    + info(messageKey: string, params: NotificationParams): void
    + warning(messageKey: string, params: NotificationParams): void
    + error(messageKey: string, params: NotificationParams): void
  }
  enum NotificationSeverity {
    success
    info
    warning
    error
  }
  BaseAssembler "1" ..> "1" BaseEntity : translates
  BaseAssembler "1" ..> "1" BaseResource : translates
  BaseAssembler "1" ..> "1" BaseResponse : reads
  BaseApiEndpoint "1" --> "1" BaseAssembler : calls
  Notifier ..> NotificationSeverity : uses
}

package "Identity and Access" {
  class User <<Entity>> {
      - id: string
      - companyId: string
      - email: string
      - firstName: string
      - lastName: string
      - role: Role
      - isActive: boolean
      + /fullName: string
      + hasRole(roles: Role[]): boolean
  }
  enum Role {
      ADMINISTRATOR
      FLEET_SUPERVISOR
      DRIVER
  }
  class SignInCommand <<Command>> {
      - email: string
      - password: string
  }
  class RegisterUserCommand <<Command>> {
      - email: string
      - password: string
      - firstName: string
      - lastName: string
      - role: Role
  }
  interface UsersQuery {
      + role: Role | null
      + isActive: boolean | null
      + page: number
      + size: number
  }
  interface UsersPage<T> {
      + users: T[]
      + totalUsers: number
  }
  class IamStore <<Store>> {
      - iamApi: IamApi
      - userAssembler: UserAssembler
      + signingIn: Signal<boolean>
      + error: Signal<string | null>
      + users: Signal<User[]>
      + totalUsers: Signal<number>
      + usersQuery: Signal<UsersQuery>
      + loadingUsers: Signal<boolean>
      + usersError: Signal<string | null>
      + savingUser: Signal<boolean>
      + saveUserError: Signal<string | null>
      + updatingUserId: Signal<string | null>
      + isSignedIn: Signal<boolean>
      + currentToken: Signal<string | null>
      + currentUser: Signal<User | null>
      + signIn(command: SignInCommand, router: Router, returnUrl: string): void
      + signOut(router: Router): void
      + loadUsers(query: Partial<UsersQuery>): void
      + registerUser(command: RegisterUserCommand, done: function): void
      + updateUser(id: string, changes: UpdateUserRequest, done: function): void
      + hasRole(roles: Role[]): boolean
      + clearSession(): void
      + clearSaveUserError(): void
      - saveSession(session: SignInResource): void
      - restoreSession(): SignInResource | null
      - errorKeyFor(error: HttpErrorResponse): string
      - saveErrorFor(error: HttpErrorResponse): string
  }
  class IamApi <<Api>> {
      - http: HttpClient
      - signInEndpoint: SignInApiEndpoint
      - usersEndpoint: UsersApiEndpoint
      + signIn(command: SignInCommand): Observable<SignInResource>
      + getUsers(query: UsersQuery): Observable<UsersPage<User>>
      + registerUser(command: RegisterUserCommand): Observable<User>
      + updateUser(id: string, changes: UpdateUserRequest): Observable<User>
  }
  class SignInApiEndpoint <<Endpoint>> {
      - http: HttpClient
      - assembler: SignInAssembler
      + signIn(command: SignInCommand): Observable<SignInResource>
  }
  class UsersApiEndpoint <<Endpoint>> {
      - http: HttpClient
      - assembler: UserAssembler
      + getPage(query: UsersQuery): Observable<UsersPage<User>>
      + create(command: RegisterUserCommand): Observable<User>
      + update(id: string, changes: UpdateUserRequest): Observable<User>
  }
  class SignInAssembler <<Assembler>> {
      + toResourceFromResponse(response, now): SignInResource
      + toRequestFromCommand(command: SignInCommand): SignInRequest
  }
  class UserAssembler <<Assembler>> {
      + toEntityFromResource(resource: UserResource): User
      + toRequestFromCommand(command): CreateUserRequest
  }
  interface SignInResource {
      + token: string
      + expiresAt: number
      + user: UserResource
  }
  interface UpdateUserRequest {
      + role?: string
      + isActive?: boolean
  }
  class iamGuard <<function>> {
      + iamGuard(route, state: RouterStateSnapshot): boolean | UrlTree
  }
  class administratorGuard <<function>> {
      + administratorGuard(): boolean | UrlTree
  }
  class iamInterceptor <<function>> {
      + iamInterceptor(request: HttpRequest, next: HttpHandlerFn): Observable<HttpEvent>
  }
  User "1" --> "1" Role : has role
  RegisterUserCommand "1" --> "1" Role : assigns
  UsersQuery "1" --> "0..1" Role : filters by
  UsersPage "1" o-- "0..*" User : groups
  IamStore "1" --> "1" IamApi : calls
  IamStore "1" --> "0..1" SignInResource : keeps session
  IamStore "1" --> "1" UsersQuery : filtered by
  IamApi "1" *-- "1" SignInApiEndpoint : owns
  IamApi "1" *-- "1" UsersApiEndpoint : owns
  SignInApiEndpoint "1" --> "1" SignInAssembler : translates
  UsersApiEndpoint "1" --> "1" UserAssembler : translates
  SignInAssembler ..> SignInResource : produces
  UserAssembler ..> User : creates
  UserAssembler ..> RegisterUserCommand : converts
  UsersApiEndpoint ..> UsersPage : returns
  iamGuard ..> IamStore : reads
  administratorGuard ..> IamStore : reads
  iamInterceptor ..> IamStore : reads token
  IamStore ..> SignInCommand : handles
  IamApi ..> UpdateUserRequest : sends
}

